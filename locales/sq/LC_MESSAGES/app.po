#: app/builder.py:25 app/ui_ops.py:81
msgid "Language"
msgstr "Gjuha"

#: app/builder.py:35 app/submission.py:64 app/ui_ops.py:72
msgid ""
"Does the design have personalization\n"
"(e.g., text from the client)?"
msgstr ""
"A ka dizajni personalizim\n"
"(p.sh., tekst nga klienti)?"

#: app/builder.py:52 app/submission.py:55 app/ui_ops.py:70
msgid "Does the design have color variations?"
msgstr "A ka dizajni variacione ngjyrash?"

#: app/builder.py:80 app/flat_maker.py:780 app/messages.py:26 app/ui_ops.py:84
msgid "✨ Suggest title & keywords"
msgstr "✨ Sugjero titullin dhe fjalet kyce"

#: app/builder.py:103 app/submission.py:366 app/ui_ops.py:86
msgid "Generate Spreadsheet"
msgstr "Gjenero tabelen"

#: app/builder.py:121 app/flat_maker.py:214 app/flat_maker.py:262
#: app/ui_ops.py:87
msgid "Save report for the developer"
msgstr "Ruaj raportin per zhvilluesin"

#: app/builder.py:128 app/ui_ops.py:74
msgid "Sizes"
msgstr "Madhesite"

#: app/builder.py:130 app/ui_ops.py:75
msgid "Print Type"
msgstr "Lloji i printimit"

#: app/builder.py:133 app/ui_ops.py:76
msgid "Decals"
msgstr "Dekale"

#: app/builder.py:134 app/ui_ops.py:77
msgid "Wallpapers"
msgstr "Tapeta"

#: app/builder.py:140 app/ui_ops.py:78
msgid "Listing Title"
msgstr "Titulli i listimit"

#: app/builder.py:148 app/ui_ops.py:80
msgid "e.g.: VN007"
msgstr "p.sh.: VN007"

#: app/builder.py:153 app/ui_ops.py:82
msgid "Keywords"
msgstr "Fjalet kyce"

#: app/builder.py:155 app/ui_ops.py:64
msgid "e.g. (in plural): Dog Wall Stickers"
msgstr "p.sh. (ne shumes): Dog Wall Stickers"

#: app/flat_maker.py:188
msgid "Update available"
msgstr "Ka nje perditesim"

#: app/flat_maker.py:191
#, python-format
msgid "Version %(new)s is available. You are using version %(current)s."
msgstr ""
"Versioni %(new)s eshte i disponueshem. Ju po perdorni versionin "
"%(current)s."

#: app/flat_maker.py:196
msgid "Skip this version"
msgstr "Kapercej kete version"

#: app/flat_maker.py:197
msgid "Later"
msgstr "Me vone"

#: app/flat_maker.py:199
msgid "How to update"
msgstr "Si te perditesoni"

#: app/flat_maker.py:235
msgid "Could not save the report."
msgstr "Raporti nuk u ruajt dot."

#: app/flat_maker.py:243
#, python-format
msgid "Report saved: %(file)s"
msgstr "Raporti u ruajt: %(file)s"

#: app/flat_maker.py:313
#, python-format
msgid ""
"AI check: the design covers only about %(percent)s%% of the main image, "
"but at least %(required)s%% is required. Consider a closer image. You can"
" still continue."
msgstr ""
"Kontrolli i AI: dizajni mbulon vetem rreth %(percent)s%% te fotos "
"kryesore, por kerkohet te pakten %(required)s%%. Merrni nje foto me te "
"afert. Mund te vazhdoni gjithsesi."

#: app/flat_maker.py:360
msgid "AI is checking the main image..."
msgstr "AI po kontrollon foton kryesore..."

#: app/flat_maker.py:366
msgid "AI check: the main image looks good."
msgstr "Kontrolli i AI: fotoja kryesore duket mire."

#: app/flat_maker.py:431
msgid "Width/height swapped?"
msgstr "Madhesite ngaterruar?"

#: app/flat_maker.py:433
msgid "Proportions off?"
msgstr "Proporcione gabim?"

#: app/flat_maker.py:447
msgid "Swap width and height"
msgstr "Nderro gjeresine me lartesine"

#: app/flat_maker.py:449
#, python-format
msgid "Use %(size)s to keep the design's proportions"
msgstr "Perdor %(size)s per te ruajtur proporcionet e dizajnit"

#: app/flat_maker.py:515
msgid "Check the sizes"
msgstr "Kontrolloni madhesite"

#: app/flat_maker.py:520
msgid ""
"These sizes do not match the design: width and height look swapped or the"
" proportions differ. Width is the horizontal side. Suggested fixes:"
msgstr ""
"Keto madhesi nuk perputhen me dizajnin: gjeresia dhe lartesia duken te "
"ngaterruara ose proporcionet ndryshojne. Gjeresia eshte ana horizontale. "
"Korrigjimet e sugjeruara:"

#: app/flat_maker.py:531
msgid "Cancel"
msgstr "Anulo"

#: app/flat_maker.py:534
msgid "Keep as entered"
msgstr "Lere sic eshte"

#: app/flat_maker.py:537
msgid "Fix and continue"
msgstr "Korrigjo dhe vazhdo"

#: app/flat_maker.py:584
msgid "The image could not be loaded. Check the link."
msgstr "Fotoja nuk u ngarkua. Kontrolloni linkun."

#: app/flat_maker.py:734 app/messages.py:24
#, python-format
msgid "Enter a valid URL for %(field)s."
msgstr "Vendosni nje URL te vlefshem per %(field)s."

#: app/flat_maker.py:735 app/ui_ops.py:108 app/ui_ops.py:203
msgid "Image Link"
msgstr "Lidhja e imazhit"

#: app/flat_maker.py:745 app/messages.py:27 app/submission.py:282
msgid "Generating..."
msgstr "Duke gjeneruar..."

#: app/flat_maker.py:759 app/messages.py:28
msgid "Title and keywords generated"
msgstr "Titulli dhe fjalet kyce u gjeneruan"

#: app/flat_maker.py:773 app/messages.py:50
msgid ""
"AI could not generate a title and keywords. Try again or fill them "
"manually."
msgstr ""
"AI nuk mundi te gjeneroje titullin dhe fjalet kyce. Provoni perseri ose "
"plotesojini manualisht."

#: app/flat_maker.py:809
#, python-format
msgid "Please choose Yes or No for %(field)s."
msgstr "Ju lutem zgjidhni Po ose Jo per %(field)s."

#: app/flat_maker.py:922
msgid "Choose a folder to save the file"
msgstr "Zgjidhni nje dosje per te ruajtur skedarin"

#: app/messages.py:12
msgid ""
"Image Link #1 warning: the design must cover at least 75 percent of the "
"full room/staged image."
msgstr ""
"Paralajmerim per Lidhjen e imazhit #1: dizajni duhet te mbuloje te pakten"
" 75 perqind te imazhit te plote te dhomes ose skenes."

#: app/messages.py:14
msgid "Press Enter to autofill."
msgstr "Enter = auto"

#: app/messages.py:15
msgid "Click to enlarge"
msgstr "Klikoni per ta zmadhuar"

#: app/messages.py:17
msgid ""
"Please fill in the required fields and choose the required options, and "
"enter valid values in the highlighted fields."
msgstr ""
"Ju lutem plotesoni fushat e detyrueshme dhe zgjidhni opsionet e "
"detyrueshme, si edhe vendosni vlera te sakta ne fushat e theksuara."

#: app/messages.py:19
msgid "Please fill in the required fields and choose the required options."
msgstr ""
"Ju lutem plotesoni fushat e detyrueshme dhe zgjidhni opsionet e "
"detyrueshme."

#: app/messages.py:20
msgid "Please enter valid values in the highlighted fields."
msgstr "Ju lutem vendosni vlera te sakta ne fushat e theksuara."

#: app/messages.py:21
msgid "Please fix the highlighted fields."
msgstr "Ju lutem korrigjoni fushat e theksuara."

#: app/messages.py:22
#, python-format
msgid "%(field)s is required."
msgstr "Fusha %(field)s eshte e detyrueshme."

#: app/messages.py:23
#, python-format
msgid "Links are not allowed in %(field)s."
msgstr "Lidhjet nuk lejohen ne fushen %(field)s."

#: app/messages.py:25 app/ui_ops.py:63
msgid "e.g. (in plural): Dog Wallpapers"
msgstr "p.sh. (ne shumes): Dog Wallpapers"

#: app/messages.py:29
msgid "AI generation is not configured. Please contact the administrator."
msgstr "Gjenerimi me AI nuk eshte konfiguruar. Kontaktoni administratorin."

#: app/messages.py:30
msgid "AI text generation is not configured. Standard template text was used."
msgstr "Gjenerimi i tekstit me AI nuk eshte konfiguruar. U perdor teksti standard."

#: app/messages.py:31
msgid ""
"AI generation is not configured correctly. Please contact the "
"administrator."
msgstr "Gjenerimi me AI nuk eshte konfiguruar sakte. Kontaktoni administratorin."

#: app/messages.py:32
msgid "AI limit was reached. Try again later."
msgstr "Limiti i AI u arrit. Provoni me vone."

#: app/messages.py:33
msgid "AI limit was reached. Standard template text was used. Try again later."
msgstr "Limiti i AI u arrit. U perdor teksti standard. Provoni me vone."

#: app/messages.py:34
msgid "AI service is temporarily unavailable. Try again later."
msgstr "Sherbimi AI eshte perkohesisht i padisponueshem. Provoni me vone."

#: app/messages.py:35
msgid "AI service is temporarily unavailable. Standard template text was used."
msgstr "Sherbimi AI eshte perkohesisht i padisponueshem. U perdor teksti standard."

#: app/messages.py:36
msgid "AI generation failed. Try again later."
msgstr "Gjenerimi me AI deshtoi. Provoni me vone."

#: app/messages.py:37
msgid "AI generation failed. Standard template text was used."
msgstr "Gjenerimi me AI deshtoi. U perdor teksti standard."

#: app/messages.py:38 app/submission.py:174
msgid "AI text generation failed. Standard template text was used."
msgstr "Gjenerimi i tekstit me AI deshtoi. U perdor teksti standard."

#: app/messages.py:40
msgid ""
"AI could not download the main image. Check that the image link opens "
"publicly."
msgstr ""
"AI nuk mundi te shkarkoje imazhin kryesor. Kontrolloni qe lidhja e "
"imazhit te hapet publikisht."

#: app/messages.py:42
msgid "AI could not read the main image. Please use another image link."
msgstr "AI nuk mundi te lexoje imazhin kryesor. Perdor nje lidhje tjeter imazhi."

#: app/messages.py:43
msgid "The main image is too large for AI analysis. Please use a smaller image."
msgstr ""
"Imazhi kryesor eshte shume i madh per analizen AI. Perdor nje imazh me te"
" vogel."

#: app/messages.py:44
msgid "AI did not return usable text. Try again."
msgstr "AI nuk ktheu tekst te perdorshem. Provoni perseri."

#: app/messages.py:45
msgid "AI returned an unexpected answer. Try again."
msgstr "AI ktheu nje pergjigje te papritur. Provoni perseri."

#: app/messages.py:46
msgid "AI returned incomplete text. Try again."
msgstr "AI ktheu tekst jo te plote. Provoni perseri."

#: app/messages.py:48
msgid ""
"AI could not create a title and keywords from this image. Try again or "
"fill them manually."
msgstr ""
"AI nuk mundi te krijoje titullin dhe fjalet kyce nga ky imazh. Provoni "
"perseri ose plotesojini manualisht."

#: app/messages.py:51 app/submission.py:351
msgid "Could not load price data. Check your internet connection and try again."
msgstr ""
"Nuk u ngarkuan te dhenat e cmimeve. Kontrolloni lidhjen tuaj me "
"internetin dhe provoni perseri."

#: app/submission.py:95 app/ui_ops.py:156
#, python-format
msgid "Up to %(count)s image links are allowed for this print type."
msgstr "Per kete lloj printimi lejohen deri ne %(count)s linke imazhesh."

#: app/submission.py:116
#, python-format
msgid "Spreadsheet generated: %(file)s"
msgstr "Tabela u krijua: %(file)s"

#: app/submission.py:130
msgid "Open file"
msgstr "Hap skedarin"

#: app/submission.py:135
msgid "Show in folder"
msgstr "Shfaq ne dosje"

#: app/submission.py:360
#, python-format
msgid "Error: %(err)s"
msgstr "Gabim: %(err)s"

#: app/ui_ops.py:88 app/ui_ops.py:90
msgid "Yes"
msgstr "Po"

#: app/ui_ops.py:89 app/ui_ops.py:91
msgid "No"
msgstr "Jo"

#: app/ui_ops.py:97
msgid "Width"
msgstr "Gjeresia"

#: app/ui_ops.py:100
msgid "Height"
msgstr "Lartesia"

