#: app/builder.py:25 app/ui_ops.py:81
msgid "Language"
msgstr "Мова"

#: app/builder.py:35 app/submission.py:64 app/ui_ops.py:72
msgid ""
"Does the design have personalization\n"
"(e.g., text from the client)?"
msgstr ""
"Дизайн має персоналізацію\n"
"(наприклад, текст від клієнта)?"

#: app/builder.py:52 app/submission.py:55 app/ui_ops.py:70
msgid "Does the design have color variations?"
msgstr "Дизайн має варіації за кольором?"

#: app/builder.py:80 app/flat_maker.py:780 app/messages.py:26 app/ui_ops.py:84
msgid "✨ Suggest title & keywords"
msgstr "✨ Запропонувати назву та ключову фразу"

#: app/builder.py:103 app/submission.py:366 app/ui_ops.py:86
msgid "Generate Spreadsheet"
msgstr "Сформувати таблицю"

#: app/builder.py:121 app/flat_maker.py:214 app/flat_maker.py:262
#: app/ui_ops.py:87
msgid "Save report for the developer"
msgstr "Зберегти звіт для розробника"

#: app/builder.py:128 app/ui_ops.py:74
msgid "Sizes"
msgstr "Розміри"

#: app/builder.py:130 app/ui_ops.py:75
msgid "Print Type"
msgstr "Тип друку"

#: app/builder.py:133 app/ui_ops.py:76
msgid "Decals"
msgstr "Декалі"

#: app/builder.py:134 app/ui_ops.py:77
msgid "Wallpapers"
msgstr "Шпалери"

#: app/builder.py:140 app/ui_ops.py:78
msgid "Listing Title"
msgstr "Назва лістингу"

#: app/builder.py:148 app/ui_ops.py:80
msgid "e.g.: VN007"
msgstr "Наприклад: VN007"

#: app/builder.py:153 app/ui_ops.py:82
msgid "Keywords"
msgstr "Ключова фраза"

#: app/builder.py:155 app/ui_ops.py:64
msgid "e.g. (in plural): Dog Wall Stickers"
msgstr "Наприклад (у множині): Dog Wall Stickers"

#: app/flat_maker.py:188
msgid "Update available"
msgstr "Доступне оновлення"

#: app/flat_maker.py:191
#, python-format
msgid "Version %(new)s is available. You are using version %(current)s."
msgstr "Доступна версія %(new)s. У вас встановлена версія %(current)s."

#: app/flat_maker.py:196
msgid "Skip this version"
msgstr "Пропустити цю версію"

#: app/flat_maker.py:197
msgid "Later"
msgstr "Пізніше"

#: app/flat_maker.py:199
msgid "How to update"
msgstr "Як оновити"

#: app/flat_maker.py:235
msgid "Could not save the report."
msgstr "Не вдалося зберегти звіт."

#: app/flat_maker.py:243
#, python-format
msgid "Report saved: %(file)s"
msgstr "Звіт збережено: %(file)s"

#: app/flat_maker.py:313
#, python-format
msgid ""
"AI check: the design covers only about %(percent)s%% of the main image, "
"but at least %(required)s%% is required. Consider a closer image. You can"
" still continue."
msgstr ""
"Перевірка ШІ: дизайн займає лише близько %(percent)s%% головного фото, а "
"потрібно не менше %(required)s%%. Краще взяти фото більшим планом. "
"Продовжити можна й так."

#: app/flat_maker.py:360
msgid "AI is checking the main image..."
msgstr "ШІ перевіряє головне фото..."

#: app/flat_maker.py:366
msgid "AI check: the main image looks good."
msgstr "Перевірка ШІ: головне фото в порядку."

#: app/flat_maker.py:431
msgid "Width/height swapped?"
msgstr "Розміри переплутано?"

#: app/flat_maker.py:433
msgid "Proportions off?"
msgstr "Не ті пропорції?"

#: app/flat_maker.py:447
msgid "Swap width and height"
msgstr "Поміняти ширину й висоту місцями"

#: app/flat_maker.py:449
#, python-format
msgid "Use %(size)s to keep the design's proportions"
msgstr "Підставити %(size)s, щоб зберегти пропорції дизайну"

#: app/flat_maker.py:515
msgid "Check the sizes"
msgstr "Перевірте розміри"

#: app/flat_maker.py:520
msgid ""
"These sizes do not match the design: width and height look swapped or the"
" proportions differ. Width is the horizontal side. Suggested fixes:"
msgstr ""
"Ці розміри не збігаються з дизайном: схоже, ширину й висоту переплутано "
"або не ті пропорції. Ширина — горизонтальна сторона. Пропоновані "
"виправлення:"

#: app/flat_maker.py:531
msgid "Cancel"
msgstr "Скасувати"

#: app/flat_maker.py:534
msgid "Keep as entered"
msgstr "Залишити як є"

#: app/flat_maker.py:537
msgid "Fix and continue"
msgstr "Виправити й продовжити"

#: app/flat_maker.py:584
msgid "The image could not be loaded. Check the link."
msgstr "Не вдалося завантажити фото. Перевірте посилання."

#: app/flat_maker.py:734 app/messages.py:24
#, python-format
msgid "Enter a valid URL for %(field)s."
msgstr "Введіть коректний URL для %(field)s."

#: app/flat_maker.py:735 app/ui_ops.py:108 app/ui_ops.py:203
msgid "Image Link"
msgstr "Посилання на зображення"

#: app/flat_maker.py:745 app/messages.py:27 app/submission.py:282
msgid "Generating..."
msgstr "Генерація..."

#: app/flat_maker.py:759 app/messages.py:28
msgid "Title and keywords generated"
msgstr "Назву та ключову фразу згенеровано"

#: app/flat_maker.py:773 app/messages.py:50
msgid ""
"AI could not generate a title and keywords. Try again or fill them "
"manually."
msgstr ""
"AI не зміг згенерувати назву та ключову фразу. Спробуйте ще раз або "
"заповніть їх вручну."

#: app/flat_maker.py:809
#, python-format
msgid "Please choose Yes or No for %(field)s."
msgstr "Будь ласка, виберіть Так або Ні для %(field)s."

#: app/flat_maker.py:922
msgid "Choose a folder to save the file"
msgstr "Оберіть папку для збереження файлу"

#: app/messages.py:12
msgid ""
"Image Link #1 warning: the design must cover at least 75 percent of the "
"full room/staged image."
msgstr ""
"Попередження для Посилання на зображення #1: дизайн має займати "
"щонайменше 75 відсотків усього зображення кімнати або сцени."

#: app/messages.py:14
msgid "Press Enter to autofill."
msgstr "Enter = автозап."

#: app/messages.py:15
msgid "Click to enlarge"
msgstr "Натисніть, щоб збільшити"

#: app/messages.py:17
msgid ""
"Please fill in the required fields and choose the required options, and "
"enter valid values in the highlighted fields."
msgstr ""
"Будь ласка, заповніть обов'язкові поля та виберіть обов'язкові опції, а "
"також введіть коректні значення у виділені поля."

#: app/messages.py:19
msgid "Please fill in the required fields and choose the required options."
msgstr "Будь ласка, заповніть обов'язкові поля та виберіть обов'язкові опції."

#: app/messages.py:20
msgid "Please enter valid values in the highlighted fields."
msgstr "Будь ласка, введіть коректні значення у виділені поля."

#: app/messages.py:21
msgid "Please fix the highlighted fields."
msgstr "Будь ласка, виправте виділені поля."

#: app/messages.py:22
#, python-format
msgid "%(field)s is required."
msgstr "Поле %(field)s є обов'язковим."

#: app/messages.py:23
#, python-format
msgid "Links are not allowed in %(field)s."
msgstr "Посилання не дозволені в полі %(field)s."

#: app/messages.py:25 app/ui_ops.py:63
msgid "e.g. (in plural): Dog Wallpapers"
msgstr "Наприклад (у множині): Dog Wallpapers"

#: app/messages.py:29
msgid "AI generation is not configured. Please contact the administrator."
msgstr "AI-генерацію не налаштовано. Зверніться до адміністратора."

#: app/messages.py:30
msgid "AI text generation is not configured. Standard template text was used."
msgstr ""
"AI-генерацію тексту не налаштовано. Використано стандартний шаблонний "
"текст."

#: app/messages.py:31
msgid ""
"AI generation is not configured correctly. Please contact the "
"administrator."
msgstr "AI-генерацію налаштовано некоректно. Зверніться до адміністратора."

#: app/messages.py:32
msgid "AI limit was reached. Try again later."
msgstr "Ліміт AI вичерпано. Спробуйте пізніше."

#: app/messages.py:33
msgid "AI limit was reached. Standard template text was used. Try again later."
msgstr ""
"Ліміт AI вичерпано. Використано стандартний шаблонний текст. Спробуйте "
"пізніше."

#: app/messages.py:34
msgid "AI service is temporarily unavailable. Try again later."
msgstr "AI-сервіс тимчасово недоступний. Спробуйте пізніше."

#: app/messages.py:35
msgid "AI service is temporarily unavailable. Standard template text was used."
msgstr "AI-сервіс тимчасово недоступний. Використано стандартний шаблонний текст."

#: app/messages.py:36
msgid "AI generation failed. Try again later."
msgstr "AI-генерація не вдалася. Спробуйте пізніше."

#: app/messages.py:37
msgid "AI generation failed. Standard template text was used."
msgstr "AI-генерація не вдалася. Використано стандартний шаблонний текст."

#: app/messages.py:38 app/submission.py:174
msgid "AI text generation failed. Standard template text was used."
msgstr "AI-генерація тексту не вдалася. Використано стандартний шаблонний текст."

#: app/messages.py:40
msgid ""
"AI could not download the main image. Check that the image link opens "
"publicly."
msgstr ""
"AI не зміг завантажити головне зображення. Перевірте, що посилання на "
"зображення відкривається публічно."

#: app/messages.py:42
msgid "AI could not read the main image. Please use another image link."
msgstr "AI не зміг прочитати головне зображення. Використайте інше посилання."

#: app/messages.py:43
msgid "The main image is too large for AI analysis. Please use a smaller image."
msgstr ""
"Головне зображення завелике для AI-аналізу. Використайте зображення "
"меншого розміру."

#: app/messages.py:44
msgid "AI did not return usable text. Try again."
msgstr "AI не повернув придатний текст. Спробуйте ще раз."

#: app/messages.py:45
msgid "AI returned an unexpected answer. Try again."
msgstr "AI повернув неочікувану відповідь. Спробуйте ще раз."

#: app/messages.py:46
msgid "AI returned incomplete text. Try again."
msgstr "AI повернув неповний текст. Спробуйте ще раз."

#: app/messages.py:48
msgid ""
"AI could not create a title and keywords from this image. Try again or "
"fill them manually."
msgstr ""
"AI не зміг створити назву та ключову фразу за цим зображенням. Спробуйте "
"ще раз або заповніть їх вручну."

#: app/messages.py:51 app/submission.py:351
msgid "Could not load price data. Check your internet connection and try again."
msgstr ""
"Не вдалося завантажити дані про ціни. Перевірте підключення до інтернету "
"та спробуйте ще раз."

#: app/submission.py:95 app/ui_ops.py:156
#, python-format
msgid "Up to %(count)s image links are allowed for this print type."
msgstr ""
"Для цього типу друку можна додати не більше %(count)s посилань на "
"зображення."

#: app/submission.py:116
#, python-format
msgid "Spreadsheet generated: %(file)s"
msgstr "Таблицю створено: %(file)s"

#: app/submission.py:130
msgid "Open file"
msgstr "Відкрити файл"

#: app/submission.py:135
msgid "Show in folder"
msgstr "Показати в папці"

#: app/submission.py:360
#, python-format
msgid "Error: %(err)s"
msgstr "Помилка: %(err)s"

#: app/ui_ops.py:88 app/ui_ops.py:90
msgid "Yes"
msgstr "Так"

#: app/ui_ops.py:89 app/ui_ops.py:91
msgid "No"
msgstr "Ні"

#: app/ui_ops.py:97
msgid "Width"
msgstr "Ширина"

#: app/ui_ops.py:100
msgid "Height"
msgstr "Висота"

